# ──────────────────────────────────────────────────────
# Sales Insight Automator – Environment Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────

# ── AI Engine (Groq - Llama 3) ──
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
AI_MODEL=llama-3.3-70b-versatile

# ── Email (SMTP) ──
# For Gmail: enable "App Passwords" at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Rabbitt AI Sales Insights

# ── App Settings ──
DEBUG=false
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173
MAX_FILE_SIZE_MB=10
RATE_LIMIT=10/minute

# ── Frontend (set if deploying separately) ──
VITE_API_URL=http://localhost:8000
